{
  "description": "DA-Flow UBnormal-HR seed42 evaluation using the UBnormal seed42 checkpoint.",
  "baseline": "daflow",
  "args": {
    "data-root": "data",
    "output-dir": "eval_outputs/daflow",
    "device": "auto",
    "seed": 42,
    "num-workers": 0,
    "batch-size": 256,
    "grad-clip": 100.0,
    "num-steps": 8,
    "num-joints": 18,
    "prior-mean": 3.0,
    "attention-kernel": 7,
    "temporal-kernel": 1,
    "adjacency-strategy": "distance",
    "max-hop": 1,
    "adjacency-norm": "digraph",
    "scale-mode": "sigmoid",
    "flow-permutation": "reverse",
    "train-stride": 6,
    "test-stride": 1,
    "missing-tolerance": 2,
    "num-transform": 1,
    "eval-every-epoch": true,
    "dataset": "hr-ubnormal",
    "checkpoint": "runs/daflow/ubnormal/checkpoint.pth.tar",
    "epochs": 8,
    "eval-batch-size": 512,
    "lr": 0.0005,
    "weight-decay": 0.0,
    "lr-decay": 1.0,
    "optimizer": "adam",
    "hidden-channels": 1,
    "smooth-sigma": 12
  }
}
