{
  "description": "DA-Flow MSAD-HR baseline checkpoint evaluation, seed42.",
  "baseline": "daflow",
  "args": {
    "dataset": "msad-hr",
    "data-root": "data",
    "prepared-dir": "outputs/msad_hr/prepared",
    "checkpoint": "runs/daflow/msad_hr/checkpoint.pth.tar",
    "output-dir": "outputs/msad_hr/daflow",
    "output-json": "eval_outputs/daflow/msad_hr.json",
    "seed": 42,
    "epochs": 8,
    "optimizer": "adam",
    "lr": 0.000001,
    "weight-decay": 0.0,
    "lr-decay": 0.99,
    "grad-clip": 100.0,
    "batch-size": 256,
    "eval-batch-size": 512,
    "num-workers": 0,
    "num-threads": 4,
    "deterministic": true,
    "num-transform": 2,
    "window": 24,
    "train-stride": 6,
    "test-stride": 1,
    "interpolation-gap": 24,
    "train-confidence-threshold": 0.4,
    "smooth-sigma": 8,
    "num-steps": 8,
    "hidden-channels": 16,
    "num-joints": 18,
    "attention-kernel": 7,
    "temporal-kernel": 1,
    "adjacency-strategy": "distance",
    "max-hop": 1,
    "adjacency-norm": "digraph",
    "scale-mode": "sigmoid",
    "flow-permutation": "reverse",
    "prior-mean": 3.0,
    "score-prior-mean": 2.3,
    "device": "cuda:0"
  }
}
