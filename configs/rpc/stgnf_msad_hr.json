{
  "description": "STG-NF MSAD-HR seed42 RPC main-result config.",
  "baseline": "rpc",
  "args": {
    "backbone": "stg-nf",
    "dataset": "MSAD-HR",
    "data_dir": "data",
    "prepared-dir": "outputs/msad_hr/prepared",
    "checkpoint": "runs/stgnf/msad_hr/checkpoint.pth.tar",
    "exp_dir": "outputs/msad_hr/stgnf",
    "output-json": "eval_outputs/rpc/stgnf_msad_hr.json",
    "calibration": "all",
    "seed": 42,
    "epochs": 8,
    "model_optimizer": "adamx",
    "model_sched": "exp_decay",
    "model_lr": 0.0005,
    "model_weight_decay": 0.0,
    "model_lr_decay": 0.99,
    "grad_clip": 100.0,
    "batch_size": 256,
    "eval_batch_size": 512,
    "num_workers": 0,
    "num_threads": 4,
    "num_transform": 2,
    "train_seg_conf_th": 0.4,
    "seg_len": 24,
    "seg_stride": 6,
    "smooth_sigma": 7,
    "interpolation_gap": 24,
    "model_hidden_dim": 0,
    "K": 2,
    "L": 4,
    "R": 3.0,
    "flow_permutation": "permute",
    "adj_strategy": "uniform",
    "max_hops": 8,
    "device": "cuda:0",
    "rpc-k": 80,
    "rpc-pool": "flatten",
    "rpc-distance": "diag_mahalanobis",
    "rpc-norm": "standard",
    "rpc-reliability-mode": "keypoint_gate",
    "rpc-reliability-floor": 0.0,
    "rpc-pc-pool": "flatten",
    "rpc-pc-k": 80,
    "rpc-pc-distance": "diag_mahalanobis",
    "rpc-pc-alpha": 10.0,
    "rpc-distance-device": "cuda:0",
    "rpc-reliability-device": "cpu",
    "rpc-normalization-device": "cpu",
    "rpc-ordered-train-features": true,
    "rpc-alpha": 10.0,
    "rpc-reliability-gamma": 4.0,
    "rpc-kmeans-iters": 30,
    "rpc-kmeans-sample-size": 50000
  }
}
