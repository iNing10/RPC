{
  "description": "STG-NF UBnormal seed42 baseline.",
  "baseline": "stg-nf",
  "args": {
    "data_dir": "data",
    "exp_dir": "eval_outputs/stgnf",
    "device": "cuda:0",
    "seed": 42,
    "verbose": 0,
    "num_workers": 8,
    "num_transform": 2,
    "train_seg_conf_th": 0.0,
    "seg_stride": 6,
    "global_pose_segs": true,
    "batch_size": 256,
    "epochs": 8,
    "model_sched": "exp_decay",
    "model_lr": 0.0005,
    "model_weight_decay": 5e-05,
    "model_lr_decay": 0.99,
    "model_hidden_dim": 0,
    "K": 8,
    "L": 1,
    "R": 3.0,
    "flow_permutation": "permute",
    "adj_strategy": "uniform",
    "max_hops": 8,
    "eval_every_epoch": true,
    "dataset": "UBnormal",
    "checkpoint": "runs/stgnf/ubnormal/checkpoint.pth.tar",
    "seg_len": 16,
    "model_optimizer": "adam"
  }
}
