{
  "description": "STG-NF MSAD-HR seed42 baseline.",
  "baseline": "stg-nf",
  "args": {
    "dataset": "MSAD-HR",
    "data_dir": "data",
    "prepared-dir": "outputs/msad_hr/prepared",
    "checkpoint": "runs/stgnf/msad_hr/checkpoint.pth.tar",
    "exp_dir": "outputs/msad_hr/stgnf",
    "output-json": "eval_outputs/stgnf/msad_hr.json",
    "seed": 42,
    "epochs": 8,
